rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles: readable/writable only by their owner.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Contact form submissions: anyone can create, only authenticated
    // backoffice/admin access should read (add custom claims later).
    match /contactMessages/{id} {
      allow create: if true
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if false;
    }

    // Product scans: owner-only read/write.
    match /scans/{scanId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
